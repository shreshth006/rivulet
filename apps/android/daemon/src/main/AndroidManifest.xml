<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The permission other apps hold to use the daemon. "dangerous" so Android
      asks the user before an app can read or write its synced data.
    -->
    <permission
        android:name="dev.rivulet.permission.ACCESS"
        android:label="@string/permission_label"
        android:description="@string/permission_description"
        android:protectionLevel="dangerous" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SyncApp"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_popup_sync"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Rivulet">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The interface other apps use. The permission is enforced in code on
          every entry point (RivuletProvider.authorise), not here: a manifest
          permission would also stop `adb shell content call` in debug builds
          before the provider could make its exception for the shell.
        -->
        <provider
            android:name=".RivuletProvider"
            android:authorities="dev.rivulet.sync.provider"
            android:exported="true" />

        <!-- Periodic and on-demand background sync. -->
        <service
            android:name=".SyncJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Optional "live sync": keeps the engine running in the foreground. -->
        <service
            android:name=".LiveSyncService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
